# Public client configuration only; never put the service-role key in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Edge Function / Supabase CLI secrets belong in the project secret manager, not here.
# SUPABASE_SERVICE_ROLE_KEY=never-commit-this

# Server-only Supabase project secrets; set with `supabase secrets set`, never in Expo.
# AI_GATEWAY_API_KEY=server-only
# JEV_PRIMARY_MODEL=anthropic/claude-sonnet-5
# JEV_FALLBACK_MODELS=openai/gpt-5.6-sol,google/gemini-3.1-pro-preview
